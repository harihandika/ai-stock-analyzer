# =============================================================
# AI Stock Analyzer - Environment Variables Template
# Salin file ini menjadi .env dan isi nilainya sesuai environment Anda.
# JANGAN commit file .env ke Git!
# =============================================================

# -------------------------
# APPLICATION
# -------------------------
APP_NAME="AI Stock Analyzer"
APP_ENV="development"  # development | production
DEBUG=True

# -------------------------
# DATABASE (PostgreSQL)
# -------------------------
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/ai_stock_analyzer_db

# Untuk Alembic (sync driver, tidak ada asyncpg)
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/ai_stock_analyzer_db

# Jika menggunakan Supabase, URL bisa dilihat di Settings > Database > Connection string
# DATABASE_URL=postgresql+asyncpg://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# -------------------------
# SECURITY (JWT)
# -------------------------
# Generate secret key dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_super_secret_key_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 jam

# -------------------------
# ANTHROPIC (Claude AI)
# -------------------------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MODEL_OPERATIONAL=claude-sonnet-4-6    # Digunakan untuk analisis harian
AI_MODEL_STRATEGIC=claude-opus-4-6        # Digunakan untuk evaluasi prompt

# -------------------------
# REDIS (Celery Broker & Cache)
# -------------------------
# Local Redis (via Docker): redis://localhost:6379/0
# Upstash Redis: redis://default:[password]@[host]:6379
REDIS_URL=redis://localhost:6379/0

# -------------------------
# MARKET DATA
# -------------------------
# Pilih yahoo atau eodhd; tidak ada fallback provider otomatis.
MARKET_DATA_PROVIDER=yahoo
EODHD_API_KEY=
# Isi delay publikasi sesuai kontrak provider sebelum menandai kalender terverifikasi.
# EOD_PUBLICATION_DELAY_MINUTES=180
MARKET_CALENDAR_VERIFIED=False
# Opt-in untuk CLI ingestion EOD; universe harus eksplisit (maksimal 20 ticker).
# Jadwalkan app.worker.market_ops ingest hanya setelah budget/kalender diverifikasi.
EOD_INGESTION_ENABLED=False
EOD_INGESTION_TICKERS=
# Jika menggunakan Alpaca, isi API key berikut:
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# -------------------------
# CORS (Untuk Frontend)
# -------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Worker job produk memakai database aplikasi sebagai antrean durable:
# python -m app.worker.product_worker
# Celery lama jika digunakan operator membaca Redis berikut, bukan SQLite Git:
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Reset password membutuhkan SMTP STARTTLS dan domain publik aplikasi.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
APP_PUBLIC_URL=http://localhost:3000
